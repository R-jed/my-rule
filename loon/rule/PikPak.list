# --- 1. 需要直连的下载/静态资源域名 (最精确，放最前面) ---
DOMAIN-SUFFIX,static.mypikpak.com,DIRECT
DOMAIN-KEYWORD,dl-z01a-,DIRECT
DOMAIN-KEYWORD,dl-a10b-,DIRECT
DOMAIN-KEYWORD,dl-b07-,DIRECT
DOMAIN-KEYWORD,thumbnail-drive,DIRECT

# --- 2. 需要拒绝的地区检测域名 ---
DOMAIN,access.mypikpak.com,REJECT
DOMAIN,access.pikpak.me,REJECT
DOMAIN,access.mypikpak.net,REJECT

# --- 3. 需要代理的 PikPak API 域名 ---
DOMAIN,api.mypikpak.com,pikpak
DOMAIN,api-drive.mypikpak.com,pikpak

# --- 4. 可选的 sandai.net 规则 ---
DOMAIN-SUFFIX,dlandroid.rcv.sandai.net,pikpak
DOMAIN-SUFFIX,hub5idx.v6.shub.sandai.net,pikpak
DOMAIN-SUFFIX,hub5pn.wap.sandai.net,pikpak
DOMAIN-SUFFIX,hub5pnc.sandai.net,pikpak
DOMAIN-SUFFIX,hub5pr.v6.phub.sandai.net,pikpak
DOMAIN-SUFFIX,hubciddata.sandai.net,pikpak

# --- 5. 兜底规则 (范围最广，放最后) ---
# 如果你确实需要把所有没写明的 mypikpak 子域名都走代理，再保留这行
# DOMAIN-SUFFIX,mypikpak.com,pikpak
